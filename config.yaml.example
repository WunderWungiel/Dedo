# Games shown on one page. Must be a positive integer.
per_page: 10

# When false, /robots.txt disallows all crawlers. true or false.
allow_indexing: true

# Optional. The address search engines should index: canonical links, og:url
# and the sitemap use this scheme, host and path prefix. Left out, they use
# the address of the request.
# canonical_url: "https://dedomil.example"

# Optional. To verify the site in Google Search Console with the HTML tag
# method, put the tag's content value here and it's printed on every page.
# DNS verification (a TXT record) needs nothing here.
# google_site_verification: ""

# Prefix for the JSON API links.
api_prefix: '/api/v1'

# Directory with game files and images, relative to the repo root.
content_dir: 'content'
