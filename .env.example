# Copy to .env. docker compose reads it automatically.

# Host address and port the nginx proxy listens on.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Time zone for all containers.
TZ=Etc/UTC

# Gunicorn worker processes in the app container.
WEB_CONCURRENCY=4

# UID/GID the app containers run as.
APP_UID=1000
APP_GID=1000

# MongoDB created on the first start (only when the volume is empty).
MONGO_DB=dedomil
MONGO_USER=mongo
MONGO_PASSWORD=change-me

# Only used when running the app without Docker.
MONGO_HOST=localhost
MONGO_PORT=27017
